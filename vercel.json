{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/project",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>[a-z0-9-]+)" }],
      "destination": "/work/:id",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "page", "value": "project" },
        { "type": "query", "key": "id", "value": "(?<id>[a-z0-9-]+)" }
      ],
      "destination": "/work/:id",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page", "value": "(?<page>about|cv|colophon)" }],
      "destination": "/:page",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
